if (CASE STREQUAL "help")
    set(args --help)
    set(expected 0)
    set(message "In-process complete-model NPU bridge")
elseif (CASE STREQUAL "missing")
    set(args --model)
    set(expected 2)
    set(message "missing value for --model")
elseif (CASE STREQUAL "negative")
    set(args --model unused --weights unused --prompt hello --predict -1)
    set(expected 2)
    set(message "--predict: invalid or out-of-range integer")
elseif (CASE STREQUAL "overflow")
    set(args --model unused --weights unused --prompt hello --ctx-size 429496729600)
    set(expected 2)
    set(message "--ctx-size: invalid or out-of-range integer")
elseif (CASE STREQUAL "unknown")
    set(args --device NPU)
    set(expected 2)
    set(message "unknown argument: --device")
else()
    message(FATAL_ERROR "unknown CLI case")
endif()
execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
if (NOT "${rc}" STREQUAL "${expected}")
    message(FATAL_ERROR "expected exit ${expected}, got ${rc}: ${out}${err}")
endif()
string(FIND "${out}${err}" "${message}" found)
if (found EQUAL -1)
    message(FATAL_ERROR "missing expected diagnostic '${message}': ${out}${err}")
endif()